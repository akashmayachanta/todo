# tasks-server settings. Copy to .env next to the server, or in the repo root for
# a build in target\release; real environment variables win over this file.

# Where it listens.
TASKS_HOST=0.0.0.0
TASKS_PORT=8050

# Prefix of every route. The app's "Path…" setting must match it. Empty serves at the root.
TASKS_API_BASE_PATH=/tasks-api

# accounts.db and one user_<id>.db per user. Relative paths are relative to this file.
TASKS_DATA_DIR=data

# Anyone who can reach the server can register from the app. Set false once
# your accounts exist; registering is the only way to add one.
TASKS_ALLOW_SIGNUP=true

# RUST_LOG=debug
